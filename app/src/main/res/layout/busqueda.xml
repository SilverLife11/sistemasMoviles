<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0221">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarBusqueda"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:background="#5E35B1"
        android:title="Buscar"
        android:titleTextColor="#FFFFFF"
        android:elevation="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/searchBar"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:orientation="horizontal"
        android:background="#1A0B3D"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:layout_margin="16dp"
        android:elevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarBusqueda"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_search"
            android:tint="#B39DDB"
            android:contentDescription="Buscar"
            tools:ignore="UseAppTint" />

        <EditText
            android:id="@+id/etBuscar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Buscar notas..."
            android:textColor="#FFFFFF"
            android:textColorHint="#B39DDB"
            android:background="@android:color/transparent"
            android:inputType="text"
            android:autofillHints="none"
            android:paddingStart="10dp"/>

    </LinearLayout>

    <TextView
        android:id="@+id/tvResultados"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:text="Resultados"
        android:textColor="#EDE7F6"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchBar" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerBusqueda"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvResultados"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>