<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0221">

    <!-- Toolbar -->

    <!-- Card para agrupar -->

    <EditText
        android:id="@+id/editTextText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:foregroundTint="#161313"
        android:inputType="text"
        android:text="Crear nueva nota"
        android:textSize="30sp"
        tools:layout_editor_absoluteX="11dp"
        tools:layout_editor_absoluteY="4dp" />

    <Button
        android:id="@+id/button"
        android:layout_width="60dp"
        android:layout_height="46dp"
        android:backgroundTint="#6E0CC1"
        android:contentDescription="boton de menu"
        android:drawableBottom="@android:drawable/ic_menu_sort_by_size"
        android:drawableTint="#0F0E0E" />

    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#1A0B3D"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Título -->
            <EditText
                android:id="@+id/etTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="none"
                android:backgroundTint="#7E57C2"
                android:hint="Título"
                android:inputType="text"
                android:padding="10dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#B39DDB"
                android:textSize="20sp" />

            <!-- Separador -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="#7E57C2" />

            <!-- Contenido -->
            <EditText
                android:id="@+id/etContenido"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autofillHints="none"
                android:background="@android:color/transparent"
                android:gravity="top"
                android:hint="Escribe tu nota..."
                android:inputType="textMultiLine"
                android:textColor="#EDE7F6"
                android:textColorHint="#9575CD" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Botón guardar -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnGuardar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:contentDescription="Guardar"
        android:src="@android:drawable/ic_menu_save"
        android:tint="@color/white"
        app:backgroundTint="#7E57C2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginTop="4dp"
        android:background="#5E35B1"
        android:elevation="6dp"
        android:title="Nueva Nota"
        android:titleTextColor="#161414"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>