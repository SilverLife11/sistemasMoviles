<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:background="#1B0433"
    android:orientation="vertical"
    app:barrierAllowsGoneWidgets="false"
    app:chainUseRtl="false">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="#6545AD"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme"
        android:visibility="visible" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:fontFamily="sans-serif-black"
        android:foregroundTint="#161313"
        android:text="MENU"
        android:textSize="34sp" />

    <Button
        android:id="@+id/button"
        android:layout_width="60dp"
        android:layout_height="46dp"
        android:backgroundTint="#6E0CC1"
        android:contentDescription="boton de menu"
        android:drawableBottom="@android:drawable/ic_menu_sort_by_size"
        android:drawableTint="#0F0E0E" />

    <Button
        android:id="@+id/button2"
        android:layout_width="227dp"
        android:layout_height="67dp"
        android:layout_gravity="center"
        android:backgroundTint="#8659CC"
        android:drawableLeft="@android:drawable/stat_notify_more"
        android:drawableTint="#0F0D0D"
        android:text="Crear nueva nota" />

    <Button
        android:id="@+id/button3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:text="Button" />
</FrameLayout>