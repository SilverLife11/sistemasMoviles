<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SistemasProyect">
        <activity
            android:name=".BusquedaActivity"
            android:exported="false"
            android:label="@string/title_activity_busqueda"
            android:theme="@style/Theme.SistemasProyect" />
        <activity
            android:name=".CalendarioActivity"
            android:exported="false"
            android:label="@string/title_activity_calendario"
            android:theme="@style/Theme.SistemasProyect" />
        <activity
            android:name=".ListaNotasActivity"
            android:exported="false"
            android:label="@string/title_activity_lista_notas"
            android:theme="@style/Theme.SistemasProyect" />
        <activity
            android:name=".NuevaNotaActivity"
            android:exported="false"
            android:label="@string/title_activity_nueva_nota"
            android:theme="@style/Theme.SistemasProyect" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SistemasProyect">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>